{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "warden",
	"compatibility_date": "2025-04-04",
	"compatibility_flags": ["nodejs_compat"],
	"main": "./workers/app.ts",
	"observability": { "enabled": true },
	// No database_name / database_id on purpose. On deploy Wrangler creates a database named
	// "<worker-name>-db" and keeps reusing it. Worker names are unique per account, so two installs never
	// share a database. The tables are created and upgraded by the Worker itself on first request.
	"d1_databases": [
		{
			"binding": "DB",
			"migrations_dir": "migrations"
		}
	],
	// Files attached to licences (updates, final releases). No bucket_name on purpose: like the database,
	// Wrangler creates "<worker-name>-files" on deploy. R2 must be activated once in the Cloudflare dashboard.
	"r2_buckets": [{ "binding": "FILES" }],
	// Rate limits (Workers rate limiting). One binding per requests-per-minute value; the dashboard (Protection,
	// Rate limits) picks which value applies to checks per address, checks per key, downloads and API requests.
	// Counters are approximate and kept per Cloudflare location. Keys include the install's host name, so two installs
	// on one account never share counts even with the same namespace_id.
	"ratelimits": [
		{ "name": "RATE_LIMIT_30", "namespace_id": "4101", "simple": { "limit": 30, "period": 60 } },
		{ "name": "RATE_LIMIT_60", "namespace_id": "4102", "simple": { "limit": 60, "period": 60 } },
		{ "name": "RATE_LIMIT_120", "namespace_id": "4103", "simple": { "limit": 120, "period": 60 } },
		{ "name": "RATE_LIMIT_300", "namespace_id": "4104", "simple": { "limit": 300, "period": 60 } },
		{ "name": "RATE_LIMIT_600", "namespace_id": "4105", "simple": { "limit": 600, "period": 60 } },
		{ "name": "RATE_LIMIT_1200", "namespace_id": "4106", "simple": { "limit": 1200, "period": 60 } }
	],
	// Daily housekeeping: deletes old check history.
	// Preview builds (pull requests and branches other than production) run `wrangler preview`, which does not reuse
	// production's rate limit counters: each limit needs its own namespace here, separate from production's so preview
	// traffic never counts against production limits. Previews get no database or file storage (Cloudflare does not
	// create them automatically, and production's must never be used by unreleased code), so a preview shows a notice
	// instead of the dashboard. Cron triggers do not run in previews.
	"previews": {
		"ratelimits": [
			{ "name": "RATE_LIMIT_30", "namespace_id": "4201", "simple": { "limit": 30, "period": 60 } },
			{ "name": "RATE_LIMIT_60", "namespace_id": "4202", "simple": { "limit": 60, "period": 60 } },
			{ "name": "RATE_LIMIT_120", "namespace_id": "4203", "simple": { "limit": 120, "period": 60 } },
			{ "name": "RATE_LIMIT_300", "namespace_id": "4204", "simple": { "limit": 300, "period": 60 } },
			{ "name": "RATE_LIMIT_600", "namespace_id": "4205", "simple": { "limit": 600, "period": 60 } },
			{ "name": "RATE_LIMIT_1200", "namespace_id": "4206", "simple": { "limit": 1200, "period": 60 } }
		]
	},
	"triggers": { "crons": ["*/10 * * * *"] }
}
